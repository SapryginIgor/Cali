# Copy to `.env` and fill in values. Expo loads `EXPO_PUBLIC_*` at build time — restart Metro after changes.

# Backend (food analysis API)
EXPO_PUBLIC_BACKEND_URL=http://localhost:8000

# Supabase — use Project URL + anon (or “publishable”) key from Supabase Dashboard → Project Settings → API.
# Do not commit real keys; use `.env` locally (gitignored).
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# RevenueCat — API keys from RevenueCat Dashboard → Project → API Keys.
EXPO_PUBLIC_RC_IOS_KEY=
EXPO_PUBLIC_RC_ANDROID_KEY=

# Optional (expo-router web origin)
# EXPO_PUBLIC_APP_ORIGIN=https://your-app-domain.com
