PORT=8000
OPENAI_API_KEY=sk-your-openai-api-key-here
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=20

# Supabase — required for JWT verification and subscription checks.
# JWT secret: Supabase Dashboard → Project Settings → API → JWT Secret
SUPABASE_JWT_SECRET=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional image storage. When these are set, S3-compatible storage is used
# instead of Supabase Storage. For DigitalOcean Spaces:
# - S3_ENDPOINT_URL is the Spaces API endpoint, not the public bucket URL.
# - S3_PUBLIC_BASE_URL is the URL returned to the app for uploaded images.
S3_BUCKET=dokploy-data
S3_REGION=sfo3
S3_ENDPOINT_URL=https://sfo3.digitaloceanspaces.com
S3_PUBLIC_BASE_URL=https://dokploy-data.sfo3.digitaloceanspaces.com
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
